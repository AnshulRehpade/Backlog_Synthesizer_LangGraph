# ─── Backlog Synthesizer LangGraph — Environment Configuration ───
# Copy this file to .env and fill in your API key(s).
# All values shown are defaults used when the variable is unset.

# LLM Provider: "openai" or "anthropic"
LLM_PROVIDER=anthropic

# ─── Anthropic ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT=60

# ─── OpenAI (alternative provider) ──────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_TIMEOUT=60

# ─── Embedding ───────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── ChromaDB (Vector Store) ─────────────────────────────────────
CHROMA_COLLECTION=backlog_items
CHROMA_PERSIST_DIR=

# ─── Gap Detection Thresholds ────────────────────────────────────
GAP_DETECTION_DUPLICATE_THRESHOLD=0.80
GAP_DETECTION_CONFLICT_THRESHOLD=0.50

# ─── Pipeline Behavior ──────────────────────────────────────────
REACT_REASONING_ENABLED=true
FEW_SHOT_ENABLED=true

# ─── Observability ──────────────────────────────────────────────
OTEL_ENABLED=true
RUNS_DIR=runs/

# ─── LangSmith (optional — visual trace UI) ─────────────────────
# Set LANGCHAIN_TRACING_V2=true and provide API key to get
# visual execution traces at https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=backlog-synthesizer

# ─── Checkpointer ──────────────────────────────────────────────
# Backend: "memory" (default, ephemeral) or "sqlite" (persistent)
CHECKPOINTER_BACKEND=memory
CHECKPOINTER_SQLITE_PATH=.checkpoints/sessions.db

# ─── Tokenizer ──────────────────────────────────────────────────
TOKENIZER_MODEL=cl100k_base

# ─── Evaluation Thresholds ──────────────────────────────────────
EVAL_KEYWORD_THRESHOLD=0.60
EVAL_F1_THRESHOLD=0.60
EVAL_REGRESSION_THRESHOLD=0.05
